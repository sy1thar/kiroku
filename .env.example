# Kiroku Environment Configuration
APP_NAME=Kiroku
APP_ENV=development
DEFAULT_LOCALE=ru
SUPPORTED_LOCALES=ru,en

# Database: SQLite by default for zero-config local run; switch to PostgreSQL in production
# Example PostgreSQL: postgresql+psycopg://kiroku:kiroku@localhost:5432/kiroku
DATABASE_URL=sqlite:///./kiroku.db

# Search Engine (optional; falls back to built-in cross-script fuzzy search if empty)
MEILISEARCH_URL=
MEILISEARCH_API_KEY=

# External APIs (AniList & VNDB work without keys; IGDB requires Twitch OAuth)
ANILIST_API_URL=https://graphql.anilist.co
VNDB_API_URL=https://api.vndb.org/kana
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional AI/MT Translation Providers for auto-drafting localized descriptions
DEEPL_API_KEY=
OPENAI_API_KEY=

# Optional Cloudflare R2 / S3 Media Storage
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=kiroku-media
R2_PUBLIC_URL=

# OAuth / Social Registration Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
